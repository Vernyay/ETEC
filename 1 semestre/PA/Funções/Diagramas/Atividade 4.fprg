<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Atividade 4"/>
        <attribute name="authors" value="willian"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-06-21 02:54:52 PM"/>
        <attribute name="created" value="d2lsbGlhbjtXSUxMSUFOOzIwMjYtMDYtMjE7MDE6NDc6NDAgUE07MjU1OQ=="/>
        <attribute name="edited" value="d2lsbGlhbjtXSUxMSUFOOzIwMjYtMDYtMjE7MDI6NTQ6NTIgUE07MTsyNjY5"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="venda, perctaxa, desconto" type="Real" array="False" size=""/>
            <declare name="aplicacao" type="Integer" array="False" size=""/>
            <declare name="pare" type="Boolean" array="False" size=""/>
            <assign variable="pare" expression="True"/>
            <while expression="pare==True">
                <input variable="venda"/>
                <input variable="aplicacao"/>
                <if expression="venda&lt;0 or aplicacao&lt;0">
                    <then>
                        <assign variable="pare" expression="False"/>
                    </then>
                    <else>
                        <assign variable="perctaxa" expression="taxa(aplicacao)"/>
                        <assign variable="desconto" expression="calculopercentual(venda, perctaxa)"/>
                    </else>
                </if>
                <output expression="&quot;Valor do desconto/acr&#233;scimo: &quot;&amp;desconto" newline="True"/>
                <output expression="&quot;Valor final com desconto/acr&#233;scimo: &quot;&amp;venda + desconto" newline="True"/>
            </while>
        </body>
    </function>
    <function name="calculopercentual" type="Real" variable="valor">
        <parameters>
            <parameter name="qtd" type="Integer" array="False"/>
            <parameter name="percentual" type="Real" array="False"/>
        </parameters>
        <body>
            <declare name="valor" type="Real" array="False" size=""/>
            <assign variable="valor" expression="(qtd * percentual) / 100"/>
        </body>
    </function>
    <function name="taxa" type="Real" variable="aplica">
        <parameters>
            <parameter name="inte" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="aplica" type="Real" array="False" size=""/>
            <if expression="inte==1">
                <then>
                    <assign variable="aplica" expression="-5.0"/>
                </then>
                <else>
                    <if expression="inte==2">
                        <then>
                            <assign variable="aplica" expression="1.0"/>
                        </then>
                        <else>
                            <if expression="inte==3">
                                <then>
                                    <assign variable="aplica" expression="4.5"/>
                                </then>
                                <else>
                                    <if expression="int==4">
                                        <then>
                                            <assign variable="aplica" expression="7.5"/>
                                        </then>
                                        <else>
                                            <assign variable="aplica" expression="10.0"/>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
