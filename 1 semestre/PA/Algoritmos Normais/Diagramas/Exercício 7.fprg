    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vkmrodado, vdias, vtotal" type="Real" array="False" size=""/>
            <input variable="vkmrodado"/>
            <input variable="vdias"/>
            <assign variable="vtotal" expression="(vkmrodado*2.2)+(vdias*90)"/>
            <output expression="&quot;Voc&#234; vai pagar: &quot;&amp;vtotal&amp;&quot; reais no total&quot;" newline="True"/>
        </body>
    </function>
