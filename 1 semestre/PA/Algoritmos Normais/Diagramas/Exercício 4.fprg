    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vcompra, vpercentualdesconto, vreaisdesconto, vnovovalor" type="Real" array="False" size=""/>
            <input variable="vcompra"/>
            <input variable="vpercentualdesconto"/>
            <assign variable="vreaisdesconto" expression="vcompra * (vpercentualdesconto/100)"/>
            <assign variable="vnovovalor" expression="vcompra-vreaisdesconto"/>
            <output expression="&quot;Vai ter um desconto de&quot;&amp;vreaisdesconto&amp;&quot;reais&quot;" newline="True"/>
            <output expression="&quot;Tendo um total de&quot;&amp;vnovovalor&amp;&quot;reais&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
