    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vlargura, valtura, vconseguepintar, varea, vlatas" type="Real" array="False" size=""/>
            <input variable="vlargura"/>
            <input variable="valtura"/>
            <input variable="vconseguepintar"/>
            <assign variable="varea" expression="vlargura*valtura"/>
            <assign variable="vlatas" expression="varea/vconseguepintar"/>
            <output expression="&quot;Sua parede tem&quot;&amp;varea&amp;&quot;metros&quot;" newline="True"/>
            <output expression="&quot;Voc&#234; precisa de&quot;&amp;vlatas&amp;&quot;latas de tinta&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
