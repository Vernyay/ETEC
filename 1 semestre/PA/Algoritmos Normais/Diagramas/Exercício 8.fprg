    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vlargura, vcomprimento, varea, vvalormercado, vmercado" type="Real" array="False" size=""/>
            <input variable="vlargura"/>
            <input variable="vcomprimento"/>
            <input variable="vvalormercado"/>
            <assign variable="varea" expression="vlargura*vcomprimento"/>
            <assign variable="vmercado" expression="varea*vvalormercado"/>
            <output expression="&quot;A &#225;rea do seu terreno &#233; de &quot;&amp;varea&amp;&quot; metros&quot;" newline="True"/>
            <output expression="&quot;Seu terreno vale &quot;&amp;vmercado&amp;&quot; reais&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
