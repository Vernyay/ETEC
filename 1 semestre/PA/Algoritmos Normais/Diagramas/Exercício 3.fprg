    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vsalariofixo, vcarros, vvendas, vtotal" type="Real" array="False" size=""/>
            <input variable="vsalariofixo"/>
            <input variable="vcarros"/>
            <input variable="vvendas"/>
            <assign variable="vtotal" expression="(2 * vsalariofixo) + (50 * vcarros) + (vvendas * 5 / 100)"/>
            <output expression="&quot;O salario total do vendedor&quot;&amp;vtotal&amp;&quot;reais&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
