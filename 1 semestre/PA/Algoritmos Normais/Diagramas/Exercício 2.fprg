    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vpeso, vquantidade, vresto" type="Real" array="False" size=""/>
            <input variable="vpeso"/>
            <input variable="vquantidade"/>
            <assign variable="vresto" expression="vpeso-((vquantidade/1000)*2*5)"/>
            <output expression="&quot;Vai sobrar:&quot;&amp;vresto&amp;&quot;kg&quot;" newline="True"/>
        </body>
    </function>
