<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="26038"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-30 10:45:38 "/>
        <attribute name="created" value="MjYwMzg7TEFCNS1NMTI7MjAyNi0wNC0zMDsiMTA6NDI6MzQgIjsxOTI2"/>
        <attribute name="edited" value="MjYwMzg7TEFCNS1NMTI7MjAyNi0wNC0zMDsiMTA6NDU6MzggIjsxOzIwNDE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vnum, vmedia, vcont" type="Integer" array="False" size=""/>
            <declare name="vcondicao" type="Boolean" array="False" size=""/>
            <assign variable="vcont" expression="0"/>
            <assign variable="vcondicao" expression="True"/>
            <while expression="vcondicao==True">
                <input variable="vnum"/>
                <if expression="vnum&lt;0">
                    <then>
                        <assign variable="vcondicao" expression="False"/>
                    </then>
                    <else>
                        <assign variable="vmedia" expression="vmedia+vnum"/>
                        <assign variable="vcont" expression="vcont+1"/>
                    </else>
                </if>
            </while>
            <assign variable="vmedia" expression="vmedia/vcont"/>
            <output expression="&quot;A m&#233;dia desses n&#250;meros &#233; &quot;&amp;vmedia" newline="True"/>
        </body>
    </function>
</flowgorithm>
