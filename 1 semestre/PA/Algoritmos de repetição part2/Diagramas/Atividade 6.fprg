<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="26038"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-04 09:47:50 "/>
        <attribute name="created" value="MjYwMzg7TEFCNS1NMTI7MjAyNi0wNC0zMDsiMTA6NDU6MzkgIjsxOTM0"/>
        <attribute name="edited" value="MjYwMzg7TEFCNS1NMTI7MjAyNi0wNC0zMDsiMTA6NDY6NTIgIjsxOzIwMzg="/>
        <attribute name="edited" value="MjYwMzg7TEFCNC1NMTI7MjAyNi0wNS0wNDsiMDk6NDc6NTAgIjsxOzIwNDY="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vnota, vcontruim, vcontrazoavel, vcontsatisfatorio, vcontbom, vcontotimo" type="Integer" array="False" size=""/>
            <declare name="vcondicao" type="String" array="False" size=""/>
            <assign variable="vcontruim" expression="0"/>
            <assign variable="vcontrazoavel" expression="0"/>
            <assign variable="vcontsatisfatorio" expression="0"/>
            <assign variable="vcontbom" expression="0"/>
            <assign variable="vcontotimo" expression="0"/>
            <assign variable="vcondicao" expression="&quot;SIM&quot;"/>
            <while expression="vcondicao!=&quot;NAO&quot;">
                <input variable="vnota"/>
                <if expression="vnota == 1">
                    <then>
                        <assign variable="vcontruim" expression="vcontruim+1"/>
                    </then>
                    <else>
                        <if expression="vnota == 2">
                            <then>
                                <assign variable="vcontrazoavel" expression="vcontrazoavel+1"/>
                            </then>
                            <else>
                                <if expression="vnota == 3">
                                    <then>
                                        <assign variable="vcontsatisfatorio" expression="vcontsatisfatorio+1"/>
                                    </then>
                                    <else>
                                        <if expression="vnota == 4">
                                            <then>
                                                <assign variable="vcontbom" expression="vcontbom+1"/>
                                            </then>
                                            <else>
                                                <if expression="vnota == 5">
                                                    <then>
                                                        <assign variable="vcontotimo" expression="vcontotimo+1"/>
                                                    </then>
                                                    <else>
                                                        <output expression="&quot;Nota inv&#225;lida! Por favor, digite uma nota de 1 a 5.&quot;" newline="True"/>
                                                    </else>
                                                </if>
                                            </else>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
                <input variable="vcondicao"/>
            </while>
            <output expression="&quot;--- RESULTADO FINAL DA CONSULTA ---&quot;" newline="True"/>
            <output expression="&quot;Quantidade de notas Ruim (1): &quot;&amp;vcontruim" newline="True"/>
            <output expression="&quot;Quantidade de notas Razo&#225;vel (2): &quot;&amp;vcontrazoavel" newline="True"/>
            <output expression="&quot;Quantidade de notas Satisfat&#243;rio (3): &quot;&amp;vcontsatisfatorio" newline="True"/>
            <output expression="&quot;Quantidade de notas Bom (4): &quot;&amp;vcontbom" newline="True"/>
            <output expression="&quot;Quantidade de notas &#211;timo (5): &quot;&amp;vcontotimo" newline="True"/>
        </body>
    </function>
</flowgorithm>
