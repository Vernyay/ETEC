<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="26038"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-07 10:28:16 "/>
        <attribute name="created" value="MjYwMzg7TEFCNS1NMTM7MjAyNi0wNS0wNzsiMDk6NTQ6NTkgIjsxOTUw"/>
        <attribute name="edited" value="MjYwMzg7TEFCNS1NMTM7MjAyNi0wNS0wNzsiMTA6Mjg6MTYgIjszOzIwNDY="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vi1, vi2, vi3, vi4, i, vnum" type="Integer" array="False" size=""/>
            <assign variable="i" expression="0"/>
            <assign variable="vi1" expression="0"/>
            <assign variable="vi2" expression="0"/>
            <assign variable="vi3" expression="0"/>
            <assign variable="vi4" expression="0"/>
            <for variable="i" start="1" end="20" direction="inc" step="1">
                <input variable="vnum"/>
                <if expression="0&lt;=vnum and vnum&lt;=25">
                    <then>
                        <assign variable="vi1" expression="vi1+1"/>
                    </then>
                    <else>
                        <if expression="26&lt;=vnum and vnum&lt;=50">
                            <then>
                                <assign variable="vi2" expression="vi2+1"/>
                            </then>
                            <else>
                                <if expression="51&lt;=vnum and vnum&lt;=75">
                                    <then>
                                        <assign variable="vi3" expression="vi3+1"/>
                                    </then>
                                    <else>
                                        <if expression="76&lt;=vnum and vnum&lt;=100">
                                            <then>
                                                <assign variable="vi4" expression="vi4+1"/>
                                            </then>
                                            <else/>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
            </for>
            <output expression="&quot;[0, 25]:   &quot;&amp;vi1" newline="True"/>
            <output expression="&quot;[26, 50]:  &quot;&amp;vi2" newline="True"/>
            <output expression="&quot;[51, 75]:  &quot;&amp;vi3" newline="True"/>
            <output expression="&quot;[76, 100]: &quot;&amp;vi4" newline="True"/>
        </body>
    </function>
</flowgorithm>
