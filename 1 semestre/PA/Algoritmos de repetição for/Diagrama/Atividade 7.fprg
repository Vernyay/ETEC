<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="26038"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-07 10:18:25 "/>
        <attribute name="created" value="MjYwMzg7TEFCNS1NMTM7MjAyNi0wNS0wNzsiMTA6MTY6MjQgIjsxOTMy"/>
        <attribute name="edited" value="MjYwMzg7TEFCNS1NMTM7MjAyNi0wNS0wNzsiMTA6MTg6MjUgIjsxOzIwNDM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vmaioresdeidade, vidade, i" type="Integer" array="False" size=""/>
            <assign variable="i" expression="0"/>
            <for variable="i" start="1" end="20" direction="inc" step="1">
                <input variable="vidade"/>
                <if expression="vidade &gt;= 18">
                    <then>
                        <assign variable="vmaioresdeidade" expression="vmaioresdeidade+1"/>
                    </then>
                    <else/>
                </if>
            </for>
            <output expression="&quot;Total de pessoas maiores de vidade: &quot;&amp;vmaioresdeidade" newline="True"/>
        </body>
    </function>
</flowgorithm>
