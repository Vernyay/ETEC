<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="26038"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-15 07:12:07 "/>
        <attribute name="created" value="MjYwMzg7TEFCNS1NMTM7MjAyNi0wNC0xNTsiMDc6MDQ6MDkgIjsxOTM2"/>
        <attribute name="edited" value="MjYwMzg7TEFCNS1NMTM7MjAyNi0wNC0xNTsiMDc6MTI6MDcgIjsxOzIwNDE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vsalbase, vperc, vaumento, vsalnovo" type="Real" array="False" size=""/>
            <input variable="vsalbase"/>
            <if expression="vsalbase &lt;= 1000">
                <then>
                    <assign variable="vperc" expression="0.20"/>
                </then>
                <else>
                    <if expression="vsalbase &lt;= 1500 and vsalbase &gt; 1000">
                        <then>
                            <assign variable="vperc" expression="0.15"/>
                        </then>
                        <else>
                            <if expression="vsalbase &lt;= 2500 and vsalbase &gt; 1500">
                                <then>
                                    <assign variable="vperc" expression="0.10"/>
                                </then>
                                <else>
                                    <assign variable="vperc" expression="0.05"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <assign variable="vaumento" expression="vsalbase * vperc"/>
            <assign variable="vsalnovo" expression="vsalbase + vaumento"/>
            <output expression="&quot;Sal&#225;rio antes: R$ &quot;&amp;vsalbase" newline="False"/>
            <output expression="&quot;Percentual: &quot;&amp;vperc * 100&amp;&quot;%&quot;" newline="True"/>
            <output expression="&quot;Valor aumento: R$ &quot;&amp;vaumento" newline="True"/>
            <output expression="&quot;Novo sal&#225;rio: R$ &quot;&amp;vsalnovo" newline="True"/>
        </body>
    </function>
</flowgorithm>
