    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vemprestimo, vnparcelas, vparcela, vsalario, vtotal" type="Real" array="False" size=""/>
            <input variable="vemprestimo"/>
            <input variable="vnparcelas"/>
            <input variable="vsalarios"/>
            <assign variable="vtotal" expression="vemprestimo * 1.10"/>
            <assign variable="vparcela" expression="vtotal / vnparcelas"/>
            <if expression="vparcela &lt;= (vsalario * 0.30)">
                <then>
                    <output expression="&quot;Empr&#233;stimo APROVADO&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Empr&#233;stimo NEGADO&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
