<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="26038"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-08 08:05:07 "/>
        <attribute name="created" value="MjYwMzg7TEFCNS1NMTM7MjAyNi0wNC0wODsiMDg6MDE6NTkgIjsxOTQx"/>
        <attribute name="edited" value="MjYwMzg7TEFCNS1NMTM7MjAyNi0wNC0wODsiMDg6MDU6MDcgIjsxOzIwNDY="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vsalario, vreajuste, vsexo" type="Real" array="False" size=""/>
            <input variable="vsalario"/>
            <input variable="vsexo"/>
            <if expression="vsexo==1 and vsalario&lt;2000">
                <then>
                    <assign variable="vreajuste" expression="vsalario*0.02"/>
                </then>
                <else>
                    <if expression="vsexo==1 and vsalario&gt;=2000">
                        <then>
                            <assign variable="vreajuste" expression="vsalario*0.05"/>
                        </then>
                        <else>
                            <if expression="vsexo==2 and vsalario&lt;2500">
                                <then>
                                    <assign variable="vreajuste" expression="vsalario*0.04"/>
                                </then>
                                <else>
                                    <assign variable="vreajuste" expression="vsalario*0.07"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="&quot;Seu sal&#225;rio reajustado ser&#225; de: &quot;&amp;vsalario+vreajuste&amp;&quot; Reais!!&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
