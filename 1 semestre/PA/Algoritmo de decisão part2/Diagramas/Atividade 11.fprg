<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="26038"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-15 07:21:56 "/>
        <attribute name="created" value="MjYwMzg7TEFCNS1NMTM7MjAyNi0wNC0xNTsiMDc6MTI6NTggIjsxOTM5"/>
        <attribute name="edited" value="MjYwMzg7TEFCNS1NMTM7MjAyNi0wNC0xNTsiMDc6MjE6NTYgIjsxOzIwNDU="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vano, vimposto, vvalorcarro" type="Real" array="False" size=""/>
            <input variable="vano"/>
            <input variable="vvalorcarro"/>
            <if expression="vano &lt; 2000">
                <then>
                    <assign variable="vimposto" expression="vvalorcarro*0.01"/>
                </then>
                <else>
                    <assign variable="vimposto" expression="vvalorcarro*0.015"/>
                </else>
            </if>
            <output expression="&quot;Valor do imposto: R$&quot;&amp;vimposto" newline="True"/>
        </body>
    </function>
</flowgorithm>
