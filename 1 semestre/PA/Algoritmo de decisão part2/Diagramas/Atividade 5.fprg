<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Atividade 6"/>
        <attribute name="authors" value="Pc"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-15 05:33:11 "/>
        <attribute name="created" value="UGM7V0lMTElBTjsyMDI2LTA0LTE1OyIwNToyNjoyMSAiOzE4OTg="/>
        <attribute name="edited" value="UGM7V0lMTElBTjsyMDI2LTA0LTE1OyIwNTozMzoxMSAiOzE7MjAwMw=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vdia" type="Integer" array="False" size=""/>
            <declare name="vsemana" type="String" array="True" size="6"/>
            <input variable="vdia"/>
            <assign variable="vsemana[0]" expression="&quot;Domingo&quot;"/>
            <assign variable="vsemana[1]" expression="&quot;Segunda&quot;"/>
            <assign variable="vsemana[2]" expression="&quot;Ter&#231;a&quot;"/>
            <assign variable="vsemana[3]" expression="&quot;Domingo&quot;"/>
            <assign variable="vsemana[4]" expression="&quot;Domingo&quot;"/>
            <assign variable="vsemana[5]" expression="&quot;Domingo&quot;"/>
            <assign variable="vsemana[6]" expression="&quot;Domingo&quot;"/>
            <if expression="vdia==1">
                <then>
                    <output expression="&quot;Esse n&#250;mero corresponde ao dia: &quot;&amp;vsemana[0]" newline="True"/>
                </then>
                <else>
                    <if expression="vdia==2">
                        <then>
                            <output expression="&quot;Esse n&#250;mero corresponde ao dia: &quot;&amp;vsemana[1]" newline="True"/>
                        </then>
                        <else>
                            <if expression="vdia==3">
                                <then>
                                    <output expression="&quot;Esse n&#250;mero corresponde ao dia: &quot;&amp;vsemana[2]" newline="True"/>
                                </then>
                                <else>
                                    <if expression="vdia==4">
                                        <then>
                                            <output expression="&quot;Esse n&#250;mero corresponde ao dia: &quot;&amp;vsemana[3]" newline="True"/>
                                        </then>
                                        <else>
                                            <if expression="vdia==5">
                                                <then>
                                                    <output expression="&quot;Esse n&#250;mero corresponde ao dia: &quot;&amp;vsemana[4]" newline="True"/>
                                                </then>
                                                <else>
                                                    <if expression="vdia==6">
                                                        <then>
                                                            <output expression="&quot;Esse n&#250;mero corresponde ao dia: &quot;&amp;vsemana[5]" newline="True"/>
                                                        </then>
                                                        <else>
                                                            <if expression="vdia==7">
                                                                <then>
                                                                    <output expression="&quot;Esse n&#250;mero corresponde ao dia: &quot;&amp;vsemana[6]" newline="True"/>
                                                                </then>
                                                                <else>
                                                                    <output expression="&quot;Valor Inv&#225;lido!!&quot;" newline="True"/>
                                                                </else>
                                                            </if>
                                                        </else>
                                                    </if>
                                                </else>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
