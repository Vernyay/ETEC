<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Atividade 4"/>
        <attribute name="authors" value="Pc"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-15 05:25:48 "/>
        <attribute name="created" value="UGM7V0lMTElBTjsyMDI2LTA0LTE1OyIwNToyMzozNyAiOzE5MDI="/>
        <attribute name="edited" value="UGM7V0lMTElBTjsyMDI2LTA0LTE1OyIwNToyNTo0OCAiOzE7MjAxNA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vcusto, vvenda" type="Real" array="False" size=""/>
            <input variable="vcusto"/>
            <if expression="vcusto&lt;20">
                <then>
                    <assign variable="vvenda" expression="vcusto*1.45"/>
                </then>
                <else>
                    <assign variable="vvenda" expression="vcusto*1.30"/>
                </else>
            </if>
            <output expression="&quot;Valor de venda: R$ &quot;&amp;vvenda" newline="True"/>
        </body>
    </function>
</flowgorithm>
