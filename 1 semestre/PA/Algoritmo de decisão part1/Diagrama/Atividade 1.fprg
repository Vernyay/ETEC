    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vnum" type="Real" array="False" size=""/>
            <input variable="vnum"/>
            <if expression="vnum=0">
                <then>
                    <output expression="&quot;Ele &#233; igual &#224; 10&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="vnum&gt;10">
                        <then>
                            <output expression="vnum&amp;&quot;&#233; maior que 10&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="vnum&amp;&quot;&#233; menor que 10&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
