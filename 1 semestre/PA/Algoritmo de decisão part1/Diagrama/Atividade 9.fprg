<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="26038"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-07 08:08:51 "/>
        <attribute name="created" value="MjYwMzg7TEFCNC1NMTI7MjAyNi0wNC0wNzsiMDc6NTU6MzggIjsxOTQz"/>
        <attribute name="edited" value="MjYwMzg7TEFCNC1NMTI7MjAyNi0wNC0wNzsiMDg6MDg6NTEgIjsxOzIwNDU="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vsalario, vreajuste" type="Real" array="False" size=""/>
            <declare name="vtempo" type="Integer" array="False" size=""/>
            <input variable="vsalario"/>
            <input variable="vtempo"/>
            <if expression="vsalario&gt;3000 and vtempo&gt;5">
                <then>
                    <assign variable="vreajuste" expression="vsalario*0.09"/>
                </then>
                <else>
                    <if expression="vsalario&lt;3000 and vtempo&gt;5">
                        <then>
                            <assign variable="vreajuste" expression="vsalario*0.12"/>
                        </then>
                        <else>
                            <assign variable="vreajuste" expression="vsalario*0.1"/>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="&quot;Seu reajuste vai ser de:&quot;&amp;vreajuste" newline="True"/>
            <output expression="&quot;Seu novo sal&#225;rio vai ser de:&quot;&amp;vsalario+vreajuste" newline="True"/>
        </body>
    </function>
</flowgorithm>
