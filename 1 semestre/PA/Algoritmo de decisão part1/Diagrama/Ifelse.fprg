    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vnum1, vnum2" type="Real" array="False" size=""/>
            <input variable="vnum1"/>
            <input variable="vnum2"/>
            <if expression="vnum1=vnum2">
                <then>
                    <output expression="&quot;Os n&#250;meros s&#227;o iguais&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="vnum1&gt;vnum2">
                        <then>
                            <output expression="vnum1&amp;&quot; &#233; maior que o &quot;&amp;vnum2" newline="True"/>
                        </then>
                        <else>
                            <output expression="vnum2&amp;&quot; &#233; maior que &quot;&amp;vnum1" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
