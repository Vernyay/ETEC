<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="26038"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-03-26 10:36:05 "/>
        <attribute name="created" value="MjYwMzg7TEFCNS1NMDk7MjAyNi0wMy0yNjsiMTA6MDg6MTcgIjsxOTM5"/>
        <attribute name="edited" value="MjYwMzg7TEFCNS1NMDk7MjAyNi0wMy0yNjsiMTA6MzY6MDUgIjsxOzIwNDU="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vsalario, vnovosalario, vreajuste" type="Real" array="False" size=""/>
            <input variable="vsalario"/>
            <if expression="vsalario&lt;2000">
                <then>
                    <assign variable="vreajuste" expression="0.15"/>
                </then>
                <else>
                    <if expression="2000=vsalario or 2000&lt;vsalario and 5000=vsalario or 5000&lt;vsalario">
                        <then>
                            <assign variable="vreajuste" expression="0.10"/>
                        </then>
                        <else>
                            <assign variable="vreajuste" expression="0.05"/>
                        </else>
                    </if>
                </else>
            </if>
            <assign variable="vnovosalario" expression="vsalario+(vsalario*vreajuste)"/>
            <output expression="&quot;Seu reajuste ser&#225; de:&quot;&amp;vsalario*vreajuste&amp;&quot;Reais&quot;" newline="True"/>
            <output expression="&quot;Seu novo s&#225;lario ser&#225;:&quot;&amp;vnovosalario&amp;&quot;Reais&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
