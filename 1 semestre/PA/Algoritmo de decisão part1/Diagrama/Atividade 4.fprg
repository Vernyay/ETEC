        <attribute name="edited" value="MjYwMzg7TEFCNS1NMDk7MjAyNi0wMy0yNjsiMTA6NDM6MzcgIjsxOzIwNDg="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vidade" type="Real" array="False" size=""/>
            <input variable="vidade"/>
            <if expression="vidade&lt;12 or vidade=12">
                <then>
                    <output expression="&quot;Categoria Infantil&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="12&lt;vidade and (vidade&lt;18 or vidade=18)">
                        <then>
                            <output expression="&quot;Categoria Juvenil&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Categoria Adulta&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
