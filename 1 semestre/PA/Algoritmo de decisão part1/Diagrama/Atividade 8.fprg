<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="26038"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-07 07:55:34 "/>
        <attribute name="created" value="MjYwMzg7TEFCNC1NMTI7MjAyNi0wNC0wNzsiMDc6NDI6MzggIjsxOTM5"/>
        <attribute name="edited" value="MjYwMzg7TEFCNC1NMTI7MjAyNi0wNC0wNzsiMDc6NTU6MzQgIjsxOzIwNDc="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vpreco, vtaxa" type="Integer" array="False" size=""/>
            <declare name="vestado" type="String" array="False" size=""/>
            <input variable="vpreco"/>
            <input variable="vestado"/>
            <if expression="vestado==&quot;SP&quot;">
                <then>
                    <assign variable="vtaxa" expression="vpreco*0.25"/>
                </then>
                <else>
                    <if expression="vestado==&quot;RJ&quot;">
                        <then>
                            <assign variable="vtaxa" expression="vpreco*0.18"/>
                        </then>
                        <else>
                            <if expression="vestado==&quot;PR&quot;">
                                <then>
                                    <assign variable="vtaxa" expression="vpreco*0.15"/>
                                </then>
                                <else>
                                    <if expression="vestado==&quot;SC&quot;">
                                        <then>
                                            <assign variable="vtaxa" expression="vpreco*0.12"/>
                                        </then>
                                        <else>
                                            <assign variable="vtaxa" expression="-1"/>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <if expression="vtaxa!=-1">
                <then>
                    <assign variable="vpreco" expression="vpreco+vtaxa"/>
                    <output expression="&quot;Valor do imposto no seu estado:&quot;&amp;vtaxa" newline="True"/>
                    <output expression="&quot;O valor final &#233; de:&quot;&amp;vpreco" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Estado n&#227;o cadastrado&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
