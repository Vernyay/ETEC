<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="26038"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-01 08:03:31 "/>
        <attribute name="created" value="MjYwMzg7TEFCNS1NMTA7MjAyNi0wNC0wMTsiMDc6NDk6MzcgIjsxOTM4"/>
        <attribute name="edited" value="MjYwMzg7TEFCNS1NMTA7MjAyNi0wNC0wMTsiMDg6MDM6MzEgIjsxOzIwMzE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vnota1, vnota2, vnota3, vnota4, vfaltas, vaulas, vmedia, vpresenca" type="Real" array="False" size=""/>
            <input variable="vnota1"/>
            <input variable="vnota2"/>
            <input variable="vnota3"/>
            <input variable="vnota4"/>
            <input variable="vaulas"/>
            <input variable="vfaltas"/>
            <assign variable="vpresenca" expression="(((vaulas-vfaltas)*100)/vaulas)"/>
            <assign variable="vmedia" expression="(vnota1+vnota2+vnota3+vnota4)/4"/>
            <if expression="vpresenca&gt;=75">
                <then>
                    <if expression="vmedia&gt;=7">
                        <then>
                            <output expression="&quot;Aluno Aprovado&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="vmedia&gt;=5 and vmedia&lt;7">
                                <then>
                                    <output expression="&quot;Aluno de Recupera&#231;&#227;o&quot;" newline="True"/>
                                </then>
                                <else>
                                    <output expression="&quot;Aluno Reprovado&quot;" newline="True"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </then>
                <else>
                    <output expression="&quot;Aluno Reprovado por falta&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
