<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="26038"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-07 07:42:31 "/>
        <attribute name="created" value="MjYwMzg7TEFCNC1NMTI7MjAyNi0wNC0wNzsiMDc6MTc6MTAgIjsxOTMx"/>
        <attribute name="edited" value="MjYwMzg7TEFCNC1NMTI7MjAyNi0wNC0wNzsiMDc6NDI6MzEgIjsxOzIwNDA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vnum1, vnum2, vnum3" type="Integer" array="False" size=""/>
            <input variable="vnum1"/>
            <input variable="vnum2"/>
            <input variable="vnum3"/>
            <if expression="vnum1==vnum2 and vnum2==vnum3">
                <then>
                    <output expression="&quot;Todos os n&#250;meros s&#227;o iguais&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="vnum1==vnum2">
                        <then>
                            <output expression="&quot;Dois n&#250;meros s&#227;o iguais:&quot;&amp;vnum1" newline="True"/>
                            <if expression="vnum1&gt;vnum3">
                                <then>
                                    <output expression="&quot;Eles s&#227;o maiores que:&quot;&amp;vnum3" newline="True"/>
                                </then>
                                <else>
                                    <output expression="&quot;Eles s&#227;o menores que:&quot;&amp;vnum3" newline="True"/>
                                </else>
                            </if>
                        </then>
                        <else>
                            <if expression="vnum2==vnum3">
                                <then>
                                    <output expression="&quot;Dois n&#250;meros s&#227;o iguais:&quot;&amp;vnum2" newline="True"/>
                                    <if expression="vnum2&gt;vnum1">
                                        <then>
                                            <output expression="&quot;Eles s&#227;o maiores que:&quot;&amp;vnum1" newline="True"/>
                                        </then>
                                        <else>
                                            <output expression="&quot;Eles s&#227;o menores que:&quot;&amp;vnum1" newline="True"/>
                                        </else>
                                    </if>
                                </then>
                                <else>
                                    <if expression="vnum1==vnum3">
                                        <then>
                                            <output expression="&quot;Dois n&#250;meros s&#227;o iguais:&quot;&amp;vnum1" newline="True"/>
                                            <if expression="vnum1&gt;vnum2">
                                                <then>
                                                    <output expression="&quot;Eles s&#227;o maiores que:&quot;&amp;vnum2" newline="True"/>
                                                </then>
                                                <else>
                                                    <output expression="&quot;Eles s&#227;o menores que:&quot;&amp;vnum2" newline="True"/>
                                                </else>
                                            </if>
                                        </then>
                                        <else>
                                            <if expression="vnum1 &gt; vnum2 and vnum1 &gt; vnum3">
                                                <then>
                                                    <output expression="vnum1&amp;&quot; &#233; o maior n&#250;mero&quot;" newline="True"/>
                                                </then>
                                                <else>
                                                    <if expression="vnum2 &gt; vnum1 and vnum2 &gt; vnum3">
                                                        <then>
                                                            <output expression="vnum2&amp;&quot; &#233; o maior n&#250;mero&quot;" newline="True"/>
                                                        </then>
                                                        <else>
                                                            <output expression="vnum3&amp;&quot; &#233; o maior n&#250;mero&quot;" newline="True"/>
                                                        </else>
                                                    </if>
                                                </else>
                                            </if>
                                            <if expression="vnum1 &lt; vnum2 and vnum1 &lt; vnum3">
                                                <then>
                                                    <output expression="vnum1&amp;&quot; &#233; o menor n&#250;mero&quot;" newline="True"/>
                                                </then>
                                                <else>
                                                    <if expression="vnum2&lt;vnum1 and vnum2&lt;vnum3">
                                                        <then>
                                                            <output expression="vnum2&amp;&quot; &#233; o menor n&#250;mero&quot;" newline="True"/>
                                                        </then>
                                                        <else>
                                                            <output expression="vnum3&amp;&quot; &#233; o menor n&#250;mero&quot;" newline="True"/>
                                                        </else>
                                                    </if>
                                                </else>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
