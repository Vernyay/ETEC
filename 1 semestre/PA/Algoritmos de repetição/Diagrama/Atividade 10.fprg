<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Atividade 10"/>
        <attribute name="authors" value="willraphael"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-26 05:09:54 PM"/>
        <attribute name="created" value="d2lsbHJhcGhhZWw7V0lMTFJBUEhBRUwwMzA0OzIwMjYtMDQtMjY7MDQ6Mzc6NDEgUE07MzQ3OA=="/>
        <attribute name="edited" value="d2lsbHJhcGhhZWw7V0lMTFJBUEhBRUwwMzA0OzIwMjYtMDQtMjY7MDU6MDk6NTQgUE07MTszNTkw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vsomasp, vsomamg, vsomarj, vqtdsp, vqtdmg, vqtdrj, vvelhasp, vvelhamg, vvelharj, vestado, vidade" type="Integer" array="False" size=""/>
            <declare name="vcondicao" type="Boolean" array="False" size=""/>
            <assign variable="vsomasp" expression="0"/>
            <assign variable="vsomamg" expression="0"/>
            <assign variable="vsomarj" expression="0"/>
            <assign variable="vqtdsp" expression="0"/>
            <assign variable="vqtdmg" expression="0"/>
            <assign variable="vqtdrj" expression="0"/>
            <assign variable="vvelhasp" expression="0"/>
            <assign variable="vvelhamg" expression="0"/>
            <assign variable="vvelharj" expression="0"/>
            <assign variable="vcondicao" expression="True"/>
            <while expression="vcondicao=True">
                <input variable="vestado"/>
                <if expression="vestado&lt;0">
                    <then>
                        <assign variable="vcondicao" expression="False"/>
                    </then>
                    <else/>
                </if>
                <if expression="vestado==1 or vestado==2 or vestado==3">
                    <then>
                        <input variable="vidade"/>
                        <if expression="vidade&gt;0">
                            <then>
                                <if expression="vestado==1">
                                    <then>
                                        <assign variable="vsomasp" expression="vsomasp+vidade"/>
                                        <assign variable="vqtdsp" expression="vqtdsp+1"/>
                                        <if expression="vidade&gt;vvelhasp">
                                            <then>
                                                <assign variable="vvelhasp" expression="vidade"/>
                                            </then>
                                            <else/>
                                        </if>
                                    </then>
                                    <else>
                                        <if expression="vestado==2">
                                            <then>
                                                <assign variable="vsomamg" expression="vsomamg+vidade"/>
                                                <assign variable="vqtdmg" expression="vqtdmg+1"/>
                                                <if expression="vidade&gt;vvelhamg">
                                                    <then>
                                                        <assign variable="vvelhamg" expression="vidade"/>
                                                    </then>
                                                    <else/>
                                                </if>
                                            </then>
                                            <else>
                                                <if expression="vestado==3">
                                                    <then>
                                                        <assign variable="vsomarj" expression="vsomarj+vidade"/>
                                                        <assign variable="vqtdrj" expression="vqtdrj+1"/>
                                                        <if expression="vidade&gt;vvelharj">
                                                            <then>
                                                                <assign variable="vvelharj" expression="vidade"/>
                                                            </then>
                                                            <else/>
                                                        </if>
                                                    </then>
                                                    <else/>
                                                </if>
                                            </else>
                                        </if>
                                    </else>
                                </if>
                            </then>
                            <else>
                                <output expression="&quot;Idade inv&#225;lida descartada.&quot;" newline="True"/>
                            </else>
                        </if>
                    </then>
                    <else>
                        <output expression="&quot;Estado inv&#225;lido descartado.&quot;" newline="True"/>
                    </else>
                </if>
            </while>
            <if expression="vqtdsp &gt; 0">
                <then>
                    <output expression="&quot;SP - M&#233;dia: &quot;&amp;vsomasp/vqtdsp&amp;&quot; | Maior: &quot;&amp;vvelhasp" newline="True"/>
                </then>
                <else/>
            </if>
            <if expression="vqtdmg &gt; 0">
                <then>
                    <output expression="&quot;MG - M&#233;dia: &quot;&amp;vsomamg/vqtdmg&amp;&quot; | Maior: &quot;&amp;vvelhamg" newline="True"/>
                </then>
                <else/>
            </if>
            <if expression="vqtdrj &gt; 0">
                <then>
                    <output expression="&quot;RJ - M&#233;dia: &quot;&amp;vsomarj/vqtdrj&amp;&quot; | Maior: &quot;&amp;vvelharj" newline="True"/>
                </then>
                <else/>
            </if>
        </body>
    </function>
</flowgorithm>
