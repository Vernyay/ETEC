<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value="Atividade 1"/>
        <attribute name="authors" value="willraphael"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-05 08:47:36 "/>
        <attribute name="created" value="d2lsbHJhcGhhZWw7V0lMTFJBUEhBRUwwMzA0OzIwMjYtMDQtMjY7MDM6MjM6MTIgUE07MzQ3MA=="/>
        <attribute name="edited" value="d2lsbHJhcGhhZWw7V0lMTFJBUEhBRUwwMzA0OzIwMjYtMDUtMDE7MTA6MDY6MjMgQU07MzszNTYw"/>
        <attribute name="edited" value="MjYwMzg7TEFCNS1NMDE7MjAyNi0wNS0wNTsiMDg6NDc6MzYgIjsyOzIwNTA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vnum, vsomapares, vsomaimpares, vcont" type="Integer" array="False" size=""/>
            <assign variable="vcont" expression="0"/>
            <assign variable="vsomaimpares" expression="0"/>
            <assign variable="vsomapares" expression="0"/>
            <for variable="vcont" start="1" end="10" direction="inc" step="1">
                <input variable="vnum"/>
                <if expression="vnum%2==0">
                    <then>
                        <assign variable="vsomapares" expression="vsomapares+vnum"/>
                    </then>
                    <else>
                        <assign variable="vsomaimpares" expression="vsomaimpares+vnum"/>
                    </else>
                </if>
            </for>
            <output expression="&quot;A soma dos &#237;mpares &#233; &quot;&amp;vsomaimpares" newline="True"/>
            <output expression="&quot;A soma dos pares &#233; &quot;&amp;vsomapares" newline="True"/>
        </body>
    </function>
</flowgorithm>
