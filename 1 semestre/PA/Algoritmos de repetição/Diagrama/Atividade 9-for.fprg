    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vnum, vcont, vresultado" type="Integer" array="False" size=""/>
            <assign variable="vcont" expression="0"/>
            <input variable="vnum"/>
            <for variable="vcont" start="1" end="10" direction="inc" step="1">
                <assign variable="vresultado" expression="vnum*vcont"/>
                <output expression="vnum&amp;&quot;X&quot;&amp;vcont&amp;&quot;=&quot;&amp;vresultado" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
