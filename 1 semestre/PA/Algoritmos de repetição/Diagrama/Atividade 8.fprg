<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Atividade 8"/>
        <attribute name="authors" value="willraphael"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-26 04:29:53 PM"/>
        <attribute name="created" value="d2lsbHJhcGhhZWw7V0lMTFJBUEhBRUwwMzA0OzIwMjYtMDQtMjY7MDQ6MjY6NTMgUE07MzQ3OQ=="/>
        <attribute name="edited" value="d2lsbHJhcGhhZWw7V0lMTFJBUEhBRUwwMzA0OzIwMjYtMDQtMjY7MDQ6Mjk6NTMgUE07MTszNTkw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vn1, vn2, vcont, vblabla, vsoma, vnatual" type="Integer" array="False" size=""/>
            <input variable="vn1"/>
            <input variable="vn2"/>
            <if expression="vn1&gt;vn2">
                <then>
                    <assign variable="vblabla" expression="vn1"/>
                    <assign variable="vn1" expression="vn2"/>
                    <assign variable="vn2" expression="vblabla"/>
                </then>
                <else/>
            </if>
            <assign variable="vnatual" expression="vn1"/>
            <while expression="vnatual&lt;=vn2">
                <assign variable="vsoma" expression="vsoma+vnatual"/>
                <assign variable="vnatual" expression="vnatual+1"/>
            </while>
            <output expression="&quot;A soma total &#233;: &quot;&amp;vsoma" newline="True"/>
        </body>
    </function>
</flowgorithm>
