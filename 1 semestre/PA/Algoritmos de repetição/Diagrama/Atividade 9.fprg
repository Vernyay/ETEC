<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Atividade 9"/>
        <attribute name="authors" value="willraphael"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-01 11:06:29 AM"/>
        <attribute name="created" value="d2lsbHJhcGhhZWw7V0lMTFJBUEhBRUwwMzA0OzIwMjYtMDQtMjY7MDQ6MzM6NDAgUE07MzQ3Mw=="/>
        <attribute name="edited" value="d2lsbHJhcGhhZWw7V0lMTFJBUEhBRUwwMzA0OzIwMjYtMDUtMDE7MTE6MDY6MjkgQU07MjszNTY2"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vnum, vcont, vresultado" type="Integer" array="False" size=""/>
            <assign variable="vcont" expression="0"/>
            <input variable="vnum"/>
            <while expression="vcont&lt;=10">
                <assign variable="vresultado" expression="vnum*vcont"/>
                <output expression="vnum&amp;&quot;X&quot;&amp;vcont&amp;&quot;=&quot;&amp;vresultado" newline="True"/>
                <assign variable="vcont" expression="vcont+1"/>
            </while>
        </body>
    </function>
</flowgorithm>
