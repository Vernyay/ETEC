<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value="Atividade 7"/>
        <attribute name="authors" value="willraphael"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-29 08:24:20 "/>
        <attribute name="created" value="d2lsbHJhcGhhZWw7V0lMTFJBUEhBRUwwMzA0OzIwMjYtMDQtMjY7MDQ6MjE6MzkgUE07MzQ3OA=="/>
        <attribute name="edited" value="d2lsbHJhcGhhZWw7V0lMTFJBUEhBRUwwMzA0OzIwMjYtMDQtMjY7MDQ6MjY6NTEgUE07MTszNTg1"/>
        <attribute name="edited" value="MjYwMzg7TEFCNS1NMTI7MjAyNi0wNC0yOTsiMDg6MjQ6MjAgIjsxOzIwNDQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vcont, vaprovados, vreprovados, vmedia" type="Integer" array="False" size=""/>
            <assign variable="vcont" expression="0"/>
            <while expression="vcont &lt; 10">
                <assign variable="vmedia" expression="0"/>
                <assign variable="vcontnota" expression="0"/>
                <while expression="vcontnota&lt;4">
                    <input variable="vnota"/>
                    <assign variable="vmedia" expression="vmedia+vnota"/>
                    <assign variable="vcontnota" expression="vcontnota+1"/>
                </while>
                <assign variable="vmedia" expression="vmedia/4"/>
                <output expression="&quot;A m&#233;dia desse aluno &#233;: &quot;&amp;vmedia" newline="True"/>
                <if expression="vmedia &gt;= 7">
                    <then>
                        <output expression="&quot;Situa&#231;&#227;o: Aprovado&quot;" newline="True"/>
                        <assign variable="vaprovados" expression="vaprovados+1"/>
                    </then>
                    <else>
                        <output expression="&quot;Situa&#231;&#227;o: Reprovado&quot;" newline="True"/>
                        <assign variable="vreprovados" expression="vreprovados+1"/>
                    </else>
                </if>
                <assign variable="vcont" expression="vcont+1"/>
            </while>
            <output expression="&quot;Total de aprovados: &quot;&amp;vaprovados" newline="True"/>
            <output expression="&quot;Total de reprovados: &quot;&amp;vreprovados" newline="True"/>
        </body>
    </function>
</flowgorithm>
