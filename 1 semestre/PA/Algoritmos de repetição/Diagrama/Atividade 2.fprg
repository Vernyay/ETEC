<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Atividade 2"/>
        <attribute name="authors" value="willraphael"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-01 10:10:07 AM"/>
        <attribute name="created" value="d2lsbHJhcGhhZWw7V0lMTFJBUEhBRUwwMzA0OzIwMjYtMDQtMjY7MDM6NTI6NTMgUE07MzQ3Nw=="/>
        <attribute name="edited" value="d2lsbHJhcGhhZWw7V0lMTFJBUEhBRUwwMzA0OzIwMjYtMDUtMDE7MTA6MTA6MDcgQU07MzszNTU3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vnum, vsoma" type="Integer" array="False" size=""/>
            <assign variable="vnum" expression="0"/>
            <assign variable="vsoma" expression="0"/>
            <while expression="vnum&gt;=0">
                <input variable="vnum"/>
                <if expression="vnum&lt;0">
                    <then/>
                    <else>
                        <assign variable="vsoma" expression="vsoma+vnum"/>
                    </else>
                </if>
            </while>
            <output expression="&quot;A soma dos n&#250;meros &#233; &quot;&amp;vsoma" newline="True"/>
        </body>
    </function>
</flowgorithm>
